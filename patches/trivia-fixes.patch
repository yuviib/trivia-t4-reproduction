+        from transformers import LogitsProcessorList
+
+        class _NanSafeLogitsProcessor:
+            """fp16 generation on GPUs without bf16 support (e.g. T4) can produce
+            NaN/inf logits during long autoregressive sampling, which crashes
+            torch.multinomial with 'probability tensor contains either inf, nan
+            or element < 0'. Sanitizing logits before sampling fixes this without
+            materially changing the sampling distribution on well-behaved steps.
+            """
+
+            def __call__(self, input_ids, scores):
+                return torch.nan_to_num(scores, nan=-1e4, posinf=1e4, neginf=-1e4)
+
+        generate_kwargs['logits_processor'] = LogitsProcessorList([_NanSafeLogitsProcessor()])
         adapter_names = self._get_adapter_names(adapter_request)
         if adapter_names is not None:
             generate_kwargs['adapter_names'] = adapter_names
